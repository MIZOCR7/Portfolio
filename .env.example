# Server-side only. Add this in Vercel → Project → Settings → Environment Variables.
GEMINI_API_KEY=

# Optional override; defaults to gemini-3.1-flash-lite.
GEMINI_MODEL=gemini-3.1-flash-lite

# Optional Gemini Live overrides; default to gemini-3.8-live and Charon.
GEMINI_LIVE_MODEL=gemini-3.8-live
GEMINI_LIVE_VOICE=Charon
